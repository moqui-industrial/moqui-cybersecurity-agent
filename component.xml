<component xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd"
          name="moqui-cybersecurity-agent" version="0.1.0">

    <!-- Phase 1: normative graph (moqui-math, moqui-mcp).
         Phase 2 (PLM/BOM machine acquisition) adds mantle-udm (Product/Asset/
         ProductCategory/Content) and moqui-device (Device/PhysicalDevice/
         DeviceConnection/DeviceContent). -->
    <depends-on name="moqui-math"/>
    <depends-on name="moqui-mcp"/>
    <depends-on name="mantle-udm"/>
    <depends-on name="moqui-device"/>
    <!-- Phase 3 (PLC/software graph): moqui-plc-knowledge is a separate component
         (forked from moqui-source-knowledge, generalized beyond the Siemens SCL
         dialect) that owns PLC/firmware source parsing and its own Graph/GraphVertex/
         GraphEdge data. This component only adds crosswalk edges from PLC vertices to
         NormClause vertices and the Device<->ProjectVersion bridge; it never merges
         the two graphs. -->
    <depends-on name="moqui-plc-knowledge"/>

    <service-factory load-path="service/"/>
    <entity-factory load-path="entity/"
            load-data="data/CyberNormGraphMetadataSeedData.xml,data/CyberMachineGraphMetadataSeedData.xml"/>
</component>
